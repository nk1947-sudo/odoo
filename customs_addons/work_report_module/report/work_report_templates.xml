<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- QWeb Template for PDF Export -->
    <template id="report_work_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Work Report</h2>
                    <p>
                        <strong>Date Range:</strong>
                        <t t-esc="data.get('date_from')"/> to
                        <t t-esc="data.get('date_to')"/>
                    </p>

                    <!-- Summary Section -->
                    <t t-if="data.get('include_summary')">
                        <h3>Summary</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Group</th>
                                    <th>Total Hours</th>
                                    <th>Billable Hours</th>
                                    <th>Non-Billable Hours</th>
                                    <th>Efficiency (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Implement grouping logic if needed -->
                            </tbody>
                        </table>
                    </t>

                    <!-- Details Section -->
                    <t t-if="data.get('include_details')">
                        <h3>Details</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Report</th>
                                    <th>Date</th>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Description</th>
                                    <th>Project</th>
                                    <th>Task</th>
                                    <th>Hours</th>
                                    <th>Billable</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="report">
                                    <t t-foreach="report.line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="report.name"/></td>
                                            <td><t t-esc="report.date"/></td>
                                            <td><t t-esc="report.employee_id.name"/></td>
                                            <td><t t-esc="report.department_id.name or ''"/></td>
                                            <td><t t-esc="line.name"/></td>
                                            <td><t t-esc="line.project_id.name or ''"/></td>
                                            <td><t t-esc="line.task_id.name or ''"/></td>
                                            <td><t t-esc="line.hours"/></td>
                                            <td><t t-esc="'Yes' if line.billable else 'No'"/></td>
                                            <td><t t-esc="dict(report._fields['state'].selection).get(report.state)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Fixed Report Action: linked to work.report -->
    <record id="action_report_work_report_pdf" model="ir.actions.report">
        <field name="name">Work Report PDF</field>
        <field name="model">work.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">work_report.report_work_report_pdf</field>
        <field name="report_file">work_report.report_work_report_pdf</field>
        <field name="print_report_name">
            <![CDATA[Work Report - %(object.name)s]]>
        </field>
    </record>

</odoo>
