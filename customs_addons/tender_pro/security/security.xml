<!-- security/security.xml -->
<odoo>
    <!-- Groups -->
    <record id="group_tender_manager" model="res.groups">
        <field name="name">Tender Manager</field>
    </record>

    <record id="group_bid_analyst" model="res.groups">
        <field name="name">Bid Analyst</field>
    </record>

    <!-- Record Rules -->
    <record id="tender_rule_company_only" model="ir.rule">
        <field name="name">Company Based Tender Access</field>
        <field name="model_id" ref="model_tender_management"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_tender_manager'))]"/>
    </record>
</odoo>
