<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Injecting assets into backend -->
    <template id="assets_backend" name="work_report_module assets" inherit_id="web.assets_backend" priority="10">
        <xpath expr="." position="inside">
            <script type="module" src="/work_report_module/static/src/js/work_report_dashboard.js"/>
            <script type="module" src="/work_report_module/static/src/js/dashboard.js"/>
            <script type="module" src="/work_report_module/static/src/js/work_report_widgets.js"/>
            <link rel="stylesheet" href="/work_report_module/static/src/css/work_report.css"/>
        </xpath>
    </template>

    <!-- QWeb Template for OWL Component -->
    <t t-name="work_report_module.WorkReportDashboard" xml:space="preserve">
        <div class="o_work_report_dashboard work-report">
            <h2>Work Report Overview</h2>
            <div class="dashboard-content">
                <p>This is a placeholder dashboard for work reports.</p>
                <!-- Add chart, stats, graphs, or widgets here -->
            </div>
        </div>
    </t>
</odoo>
