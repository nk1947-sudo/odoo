<odoo>
    <record id="view_generate_work_report_wizard" model="ir.ui.view">
        <field name="name">generate.work.report.wizard.form</field>
        <field name="model">generate.work.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Work Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_work_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Work Report</field>
        <field name="res_model">generate.work.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
