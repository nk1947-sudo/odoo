<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Kanban view for work.report.line -->
    <record id="view_work_report_line_kanban" model="ir.ui.view">
        <field name="name">work.report.line.kanban</field>
        <field name="model">work.report.line</field>
        <field name="type">kanban</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <templates>
                    <t t-name="kanban-box">
                        <card>
                            <div class="oe_kanban_global_click">
                                <strong><field name="name"/></strong>
                                <p><field name="hours"/> hours</p>
                            </div>
                        </card>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view for work.report.line -->
    <record id="view_work_report_line_list" model="ir.ui.view">
        <field name="name">work.report.line.list</field>
        <field name="model">work.report.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="report_id"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="hours"/>
                <field name="billable"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form view for work.report.line -->
    <record id="view_work_report_line_form" model="ir.ui.view">
        <field name="name">work.report.line.form</field>
        <field name="model">work.report.line</field>
        <field name="arch" type="xml">
            <form string="Work Report Line">
                <sheet>
                    <group>
                        <field name="report_id" readonly="1" required="1"/>
                        <field name="name" required="1"/>
                        <field name="project_id"/>
                        <field name="task_id"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="date" readonly="1"/>
                        <field name="hours" required="1"/>
                        <field name="billable"/>
                        <field name="sequence"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action for work.report.line -->
    <record id="action_work_report_line" model="ir.actions.act_window">
        <field name="name">Work Report Lines</field>
        <field name="res_model">work.report.line</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a new work report line.
            </p>
        </field>
    </record>

    <!-- Menu item for work.report.line -->
    <menuitem
        id="menu_work_report_line"
        name="Work Report Lines"
        parent="work_report_menu_root"
        action="action_work_report_line"
        sequence="20"/>
        
</odoo>
