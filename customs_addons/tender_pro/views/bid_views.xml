<!-- views/bid_views.xml -->
<odoo>
    
    
    <record id="view_tree_tender_bid" model="ir.ui.view">
        <field name="name">tender.bid.list</field>
        <field name="model">tender.bid</field>
        <field name="type">list</field> <!-- Changed the type from tree to list -->
        <field name="arch" type="xml">
            <list>
                <field name="tender_id"/>
                <field name="bidder_name"/>
                <field name="bid_amount"/>
                <field name="submitted_on"/>
                <field name="outcome"/>
            </list>
        </field>
    </record>
    
    <record id="view_kanban_tender_bid" model="ir.ui.view">
        <field name="name">tender.bid.kanban</field>
        <field name="model">tender.bid</field>
        <field name="type">kanban</field> <!-- Set the type to kanban -->
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="bidder_name"/></strong>
                            <div>Bid Amount: <field name="bid_amount"/></div>
                            <div>Submitted On: <field name="submitted_on"/></div>
                            <div>Outcome: <field name="outcome"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_form_tender_bid" model="ir.ui.view">
        <field name="name">tender.bid.form</field>
        <field name="model">tender.bid</field>
        <field name="type">form</field> <!-- Explicitly set the type -->
        <field name="arch" type="xml">
            <form string="Tender Bid">
                <sheet>
                    <group>
                        <field name="tender_id"/>
                        <field name="bidder_name"/>
                        <field name="bid_amount"/>
                        <field name="submitted_on"/>
                        <field name="outcome"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tender_bid" model="ir.actions.act_window">
        <field name="name">Tender Bids</field>
        <field name="res_model">tender.bid</field>
        <field name="view_mode">kanban,form</field> <!-- Use kanban and form views -->
    </record>
</odoo>
