<!-- data/email_templates.xml -->
<odoo>
    <record id="email_template_tender_reminder" model="mail.template">
        <field name="name">Tender Deadline Reminder</field>
        <field name="model_id" ref="model_tender_management"/>
        <field name="subject">Reminder: Tender ${object.title} is due soon!</field>
        <field name="email_from">${(user.email or 'noreply@yourdomain.com')}</field>
        <field name="email_to">${object.create_uid.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Hello,</p>
                <p>This is a reminder that the tender <strong>${object.title}</strong> (Ref: ${object.reference}) is approaching its deadline on <strong>${object.deadline}</strong>.</p>
                <p>Please review and complete necessary actions.</p>
                <p>Regards,<br/>Tender Management System</p>
            ]]>
        </field>
    </record>
</odoo>
