<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View for Work Report Template -->
    <record id="view_work_report_template_form" model="ir.ui.view">
        <field name="name">work.report.template.form</field>
        <field name="model">work.report.template</field>
        <field name="arch" type="xml">
            <form string="Work Report Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Template Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="task_id"/>
                                    <field name="billable"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View for Work Report Template -->
    <record id="view_work_report_template_kanban" model="ir.ui.view">
        <field name="name">work.report.template.kanban</field>
        <field name="model">work.report.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="category_id"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <card>
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_bottom text-muted">
                                    <span><field name="category_id"/></span>
                                    <span t-if="record.active.raw_value" class="badge badge-success ml-2">Active</span>
                                    <span t-if="!record.active.raw_value" class="badge badge-danger ml-2">Inactive</span>
                                </div>
                            </div>
                        </card>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    
    <!-- ✅ QWeb Template for Work Report Export -->
    <template id="report_work_report_pdf">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Work Report Export</h2>
                <p>
                    <strong>From:</strong> <t t-esc="doc.date_from"/><br/>
                    <strong>To:</strong> <t t-esc="doc.date_to"/>
                </p>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Report Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.employee_ids" t-as="employee">
                            <td><t t-esc="employee.name"/></td>
                            <td>
                                <t t-set="report_count" t-value="len(env['work.report'].search([('employee_id', '=', employee.id), ('date', '&gt;=', doc.date_from), ('date', '&lt;=', doc.date_to)]))"/>
                                <t t-esc="report_count"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- ✅ Report Action -->
    <record id="action_report_work_report_pdf" model="ir.actions.report">
        <field name="name">Work Report PDF</field>
        <field name="model">work.report.export</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">work_report.report_work_report_pdf</field>
        <field name="report_file">work_report.report_work_report_pdf</field>
        <field name="print_report_name">
            <![CDATA[Work Report - %(object.date_from)s]]>
        </field>
    </record>

</odoo>
