<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_work_report_user" model="res.groups">
        <field name="name">Work Report User</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_work_report_manager" model="res.groups">
        <field name="name">Work Report Manager</field>
        <field name="category_id" ref="base.module_category_administration"/>
        <field name="implied_ids" eval="[(4, ref('group_work_report_user'))]"/>
    </record>

    <!-- Access Rules -->
    <record id="work_report_line_user_rule" model="ir.rule">
        <field name="name">Work Report Line: User Access</field>
        <field name="model_id" ref="model_work_report_line"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_work_report_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="work_report_line_manager_rule" model="ir.rule">
        <field name="name">Work Report Line: Manager Access</field>
        <field name="model_id" ref="model_work_report_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_work_report_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="work_report_category_manager" model="ir.rule">
        <field name="name">Work Report Category: Manager Access</field>
        <field name="model_id" ref="model_work_report_category"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_work_report_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="work_report_tag_manager" model="ir.rule">
        <field name="name">Work Report Tag: Manager Access</field>
        <field name="model_id" ref="model_work_report_tag"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_work_report_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>