<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu for the Work Report module -->
    <menuitem id="work_report_menu_root"
              name="Work Reports"
              sequence="10"
              web_icon="work_report_module/static/description/icon.png"/>

    <!-- Window Action to open Work Reports -->
    <record id="action_work_report" model="ir.actions.act_window">
        <field name="name">Work Reports</field>
        <field name="res_model">work.report</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first work report
            </p>
        </field>
    </record>

    <!-- Submenu: All Reports -->
    <menuitem id="work_report_menu_reports"
              name="All Reports"
              parent="work_report_menu_root"
              sequence="20"
              action="action_work_report"/>

    <!-- Client Action: Dashboard -->
    <record id="action_work_report_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">work_report_dashboard</field>
    </record>

    <!-- Submenu: Dashboard -->
    <menuitem id="menu_work_report_dashboard"
              name="Dashboard"
              parent="work_report_menu_root"
              sequence="5"
              action="action_work_report_dashboard"/>
</odoo>
