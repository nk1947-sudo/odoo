<!-- views/tender_views.xml -->
<odoo>
    <record id="view_form_tender" model="ir.ui.view">
        <field name="name">tender.management.form</field>
        <field name="model">tender.management</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <sheet>
                    <group>
                        <field name="reference" readonly="1"/>
                        <field name="title"/>
                        <field name="category"/>
                        <field name="department_id"/>
                        <field name="estimated_value"/>
                        <field name="deadline"/>
                        <field name="status"/>
                        <field name="ai_score_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Bids">
                            <field name="bid_ids">
                                <kanban>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click">
                                                <strong><field name="bidder_name"/></strong>
                                                <div>Bid Amount: <field name="bid_amount"/></div>
                                                <div>Submitted On: <field name="submitted_on"/></div>
                                                <div>Outcome: <field name="outcome"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kanban_tender" model="ir.ui.view">
        <field name="name">tender.management.kanban</field>
        <field name="model">tender.management</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="title"/></strong>
                            <div>Reference: <field name="reference"/></div>
                            <div>Category: <field name="category"/></div>
                            <div>Department: <field name="department_id"/></div>
                            <div>Deadline: <field name="deadline"/></div>
                            <div>Status: <field name="status"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_tender_management" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">tender.management</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <menuitem id="menu_action_tender_management"
              name="Tenders"
              parent="menu_tender_main"
              action="action_tender_management"/>
</odoo>
