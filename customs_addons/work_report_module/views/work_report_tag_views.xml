<odoo>
    <record id="view_work_report_tag_form" model="ir.ui.view">
        <field name="name">work.report.tag.form</field>
        <field name="model">work.report.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_work_report_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">work.report.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
